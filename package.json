{
  "name": "@datadayrepos/eslint-define-config",
  "version": "1.24.14",
  "description": "Provide a defineConfig function for .eslintrc.js files",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup-node",
    "format": "prettier --cache --write .",
    "lint:run": "eslint --cache --cache-strategy content --report-unused-disable-directives .",
    "lint": "run-s build lint:run",
    "typecheck": "vitest --typecheck.only --typecheck.tsconfig tsconfig.dev.json",
    "ts-check": "tsc -p tsconfig.dev.json",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate:rules": "tsx ./scripts/generate-rule-files/cli.ts",
    "prepublishOnly": "node scripts/npm-package.mjs guard",
    "preflight": "pnpm install && run-s format lint ts-check test typecheck",
    "prepack": "node scripts/npm-package.mjs guard",
    "pack:release": "node scripts/npm-package.mjs pack",
    "pub": "node scripts/npm-package.mjs publish"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "config",
    "configuration",
    "define-config",
    "eslint-config",
    "eslint",
    "eslintconfig",
    "typed",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datadayrepos/eslint-define-config.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@graphql-eslint/eslint-plugin": "~4.4.2",
    "@intlify/eslint-plugin-vue-i18n": "~4.5.1",
    "@poppinss/cliui": "~3.0.5",
    "@swc/core": "~1.16.22",
    "@types/eslint": "~8.44.3",
    "@types/json-schema": "~7.0.13",
    "@types/node": "~20.8.3",
    "@typescript-eslint/eslint-plugin": "~6.7.4",
    "@typescript-eslint/parser": "~6.7.4",
    "@vitest/coverage-v8": "~4.1.12",
    "change-case": "~4.1.2",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "~9.0.0",
    "eslint-gitignore": "~0.1.0",
    "eslint-plugin-deprecation": "~2.0.0",
    "eslint-plugin-eslint-comments": "~3.2.0",
    "eslint-plugin-import": "~2.28.1",
    "eslint-plugin-inclusive-language": "~2.2.1",
    "eslint-plugin-jsdoc": "~46.8.2",
    "eslint-plugin-jsonc": "~2.9.0",
    "eslint-plugin-jsx-a11y": "~6.7.1",
    "eslint-plugin-mdx": "~2.2.0",
    "eslint-plugin-n": "~16.1.0",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-prettier": "~5.0.0",
    "eslint-plugin-promise": "~6.1.1",
    "eslint-plugin-react": "~7.33.2",
    "eslint-plugin-react-hooks": "~4.6.0",
    "eslint-plugin-sonarjs": "~0.21.0",
    "eslint-plugin-spellcheck": "~0.0.20",
    "eslint-plugin-testing-library": "~6.0.2",
    "eslint-plugin-unicorn": "~48.0.1",
    "eslint-plugin-vitest": "~0.3.2",
    "eslint-plugin-vue": "~9.17.0",
    "eslint-plugin-vue-pug": "~0.6.0",
    "eslint-plugin-yml": "~1.9.0",
    "expect-type": "~0.17.3",
    "graphql": "~16.8.1",
    "json-schema": "~0.4.0",
    "json-schema-to-ts": "~3.1.1",
    "json-schema-to-typescript": "~13.1.1",
    "npm-run-all": "~4.1.5",
    "prettier": "3.0.3",
    "prettier-plugin-organize-imports": "~3.2.3",
    "rimraf": "~6.1.4",
    "ts-dedent": "~2.2.0",
    "tsup": "8.5.0",
    "tsx": "~4.23.15",
    "typescript": "~5.2.2",
    "vite": "~6.4.4",
    "vitest": "~4.1.12",
    "vue-eslint-parser": "~10.4.2"
  },
  "pnpm": {
    "overrides": {
      "@graphql-tools/utils@<12.0.2": "12.0.2",
      "glob@>=9 <14.0.2": "14.0.3",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "tsup>esbuild": "0.28.2",
      "eslint-plugin-vue-pug>vue-eslint-parser-template-tokenizer-pug": "1.0.0"
    }
  },
  "packageManager": "pnpm@8.8.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "pnpm": ">= 8.6.0"
  }
}
